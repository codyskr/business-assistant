TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
ALLOWED_TELEGRAM_USER_IDS=

TIMEZONE=Europe/Moscow
GOOGLE_CALENDAR_ID=primary
AUTO_CONFIRM_ACTIONS=false
DEFAULT_EVENT_REMINDER_MINUTES=15

# Privacy:
# strict   = voice stays local, no cloud STT
# balanced = try selected cloud STT, fallback to local
PRIVACY_MODE=balanced

# Speech-to-text:
# local = faster-whisper on this machine
# groq  = free/limited Groq Whisper API, fallback can stay local
# openai = paid OpenAI STT, useful later for stability
STT_PROVIDER=groq
STT_FALLBACK_PROVIDER=local
STT_MAX_VOICE_SECONDS=300
WHISPER_MODEL=base
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Local laptop wake-word listener. The listener does not use Groq; it records
# speech locally, transcribes with local Whisper, then sends text to bot.py.
LOCAL_COMMAND_ENABLED=false
LOCAL_COMMAND_HOST=127.0.0.1
LOCAL_COMMAND_PORT=8765
LOCAL_COMMAND_TOKEN=change_me
LOCAL_COMMAND_URL=http://127.0.0.1:8765/command
WAKE_WORDS=ассистент,помощник
WAKE_INPUT_DEVICE=
WAKE_TRANSCRIBE_PROVIDER=local
WAKE_TELEGRAM_CHAT_ID=
WAKE_TELEGRAM_USER_ID=
WAKE_ENERGY_THRESHOLD=0.012
WAKE_MAX_RECORD_SECONDS=12
WAKE_SAVE_RECORDINGS=false
WAKE_DEBUG_DIR=data/voice_debug

# Local intent model fallback.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

MEMORY_ENABLED=true
MEMORY_KEY_PATH=data/memory.key
MEMORY_RETENTION_DAYS=7
MEMORY_RECENT_MESSAGES=12
MEMORY_RECENT_ACTIONS=6
